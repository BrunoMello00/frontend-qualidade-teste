{
  "name": "estoque-vendas-frontend",
  "version": "1.0.0",
  "description": "Sistema de Gerenciamento de Estoque e Vendas - Frontend",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:prod": "ng serve --configuration production",
    "backend:compile": "cd backend-java && mvn clean compile",
    "backend:test": "cd backend-java && mvn test",
    "backend:test-report": "cd backend-java && mvn clean test jacoco:report",
    "backend:package": "cd backend-java && mvn clean package",
    "backend:run": "cd backend-java && mvn spring-boot:run",
    "backend:compile:settings2": "cd backend-java && mvn clean compile -s settings2.xml",
    "backend:test:settings2": "cd backend-java && mvn test -s settings2.xml",
    "backend:run:settings2": "cd backend-java && mvn spring-boot:run -s settings2.xml",
    "full:test": "npm run backend:test && npm run test",
    "full:build": "npm run backend:package && npm run build",
    "dev": "concurrently \"npm run start\" \"echo 'Frontend rodando em http://localhost:4200'\"",
    "dev:fullstack": "concurrently \"npm run backend:run\" \"npm run start\" --names \"Backend,Frontend\" --prefix-colors \"blue,green\"",
    "dev:fullstack:settings2": "concurrently \"npm run backend:run:settings2\" \"npm run start\" --names \"Backend,Frontend\" --prefix-colors \"blue,green\"",
    "start:backend": "npm run backend:run",
    "start:both": "npm run dev:fullstack",
    "postinstall": "cd backend-java && mvn clean compile"
  },
  "dependencies": {
    "@angular/animations": "^17.0.0",
    "@angular/cdk": "^17.0.0",
    "@angular/common": "^17.0.0",
    "@angular/compiler": "^17.0.0",
    "@angular/core": "^17.0.0",
    "@angular/forms": "^17.0.0",
    "@angular/material": "^17.0.0",
    "@angular/platform-browser": "^17.0.0",
    "@angular/platform-browser-dynamic": "^17.0.0",
    "@angular/router": "^17.0.0",
    "@types/jspdf": "^1.3.3",
    "bootstrap": "^5.3.0",
    "bootstrap-icons": "^1.11.0",
    "chart.js": "^4.4.0",
    "jspdf": "^3.0.2",
    "jspdf-autotable": "^5.0.2",
    "ng2-charts": "^6.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.0.0",
    "@angular/cli": "^17.0.0",
    "@angular/compiler-cli": "^17.0.0",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^18.18.0",
    "concurrently": "^8.2.2",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.2.0"
  }
}
